{
  "manifest_version": 3,
  "name": "Sentinela · Governança de IA",
  "short_name": "Sentinela",
  "version": "5.0.0",
  "description": "O Sentinela ajuda a identificar possíveis dados sensíveis durante o uso de ferramentas de inteligência artificial, emitindo alertas antes do envio das informações.",
  "permissions": ["storage", "offscreen", "alarms", "scripting"],
  "host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sentinela",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png",
      "48": "icones/icone48.png",
      "128": "icones/icone128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["sentinela-logo.svg"],
      "matches": ["https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.cloud.microsoft/*",
        "https://copilot.microsoft.com/*",
        "https://www.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*"
      ],
      "js": ["detectores.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
